<view class="page">
    <view class="md-head">
        <text class="md-head-eyebrow">PROFILES</text>
        <text class="md-head-title">档案管理</text>
        <text class="md-head-sub">为自己或家人分别建立档案，数据按档案分开记录</text>
    </view>

    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="state-title">正在加载</text>
        <text class="state-description">请稍候。</text>
    </view>

    <view class="state-card state-card-error" wx:elif="{{viewState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">加载失败</text>
        <text class="state-description">{{errorMessage}}</text>
        <view class="primary-button" bindtap="handleRetry">重试</view>
    </view>

    <view class="md-card" wx:else>
        <view wx:if="{{items.length === 0}}" class="list-empty">
            <text class="list-empty-text">还没有档案，点「新建档案」创建第一个。</text>
        </view>
        <view class="profile-item" wx:for="{{items}}" wx:key="id">
            <view class="profile-main">
                <view class="profile-line">
                    <text class="profile-name">{{item.name}}</text>
                    <text class="profile-badge">{{item.relation}}</text>
                    <text class="active-badge" wx:if="{{item.isActive}}">当前使用</text>
                </view>
                <text class="profile-count">{{item.count}} 条记录</text>
            </view>
            <view class="profile-actions">
                <view class="action-button btn-tonal" hover-class="btn-hover" wx:if="{{!item.isActive}}" data-id="{{item.id}}" bindtap="handleSwitch">设为当前</view>
                <view class="action-button btn-tonal" hover-class="btn-hover" data-id="{{item.id}}" bindtap="openEdit">编辑</view>
                <view class="action-button btn-error" hover-class="btn-hover" data-id="{{item.id}}" bindtap="handleDelete">删除</view>
            </view>
        </view>
    </view>

    <view class="fab" hover-class="fab-hover" bindtap="openCreate">+</view>

    <view class="editor-mask {{editorClosing ? 'editor-closing' : ''}}" wx:if="{{showEditor}}" bindtap="closeEditor"></view>
    <view class="editor-sheet {{editorClosing ? 'editor-closing' : ''}}" wx:if="{{showEditor}}">
        <text class="sheet-title">{{editorTitle}}</text>
        <text class="sheet-error" wx:if="{{formError !== ''}}">{{formError}}</text>

        <view class="field-group">
            <view class="md-field {{focusField === 'name' ? 'md-focus' : ''}}">
                <text class="md-label">称呼</text>
                <input class="md-input" placeholder="如 本人 / 妈妈 / 小宝" placeholder-class="md-placeholder" value="{{formName}}" data-field="name" bindinput="handleNameInput" bindfocus="handleFieldFocus" bindblur="handleFieldBlur" maxlength="20" />
            </view>
        </view>

        <view class="field-group">
            <text class="field-label">与我的关系</text>
            <view class="md-chip-row">
                <view class="md-chip {{formRelationIndex === index ? 'md-chip-active' : ''}}" hover-class="md-chip-hover" wx:for="{{relations}}" wx:key="*this" data-index="{{index}}" bindtap="handleRelationChip">{{item}}</view>
            </view>
        </view>

        <view class="field-group">
            <view class="md-area {{focusField === 'note' ? 'md-focus' : ''}}">
                <text class="md-area-label">备注</text>
                <textarea class="md-area-textarea" placeholder="可选，如出生年份、过敏史等" placeholder-class="area-placeholder" value="{{formNote}}" data-field="note" bindinput="handleNoteInput" bindfocus="handleFieldFocus" bindblur="handleFieldBlur" maxlength="200" />
            </view>
        </view>

        <view class="sheet-actions">
            <view class="sheet-button" bindtap="closeEditor">取消</view>
            <view class="sheet-button primary-button {{submitting ? 'is-disabled' : ''}}" hover-class="btn-hover" bindtap="handleSave"><view class="spinner spinner-sm spinner-white" wx:if="{{submitting}}"></view>{{submitting ? '保存中…' : '保存'}}</view>
        </view>
    </view>
</view>
