/* 图表页特有样式；MD 通用样式见 app.wxss */

/* 时间范围：MD Segmented Button */
.segment {
    display: flex;
    box-sizing: border-box;
    padding: 8rpx;
    border-radius: 999rpx;
    background: #E7E0EC;
    margin-bottom: 24rpx;
}

.segment-item {
    flex: 1;
    padding: 16rpx 0;
    border-radius: 999rpx;
    color: #49454F;
    text-align: center;
    font-size: 26rpx;
    transition: background 0.15s ease, color 0.15s ease;
}

.segment-active {
    background: #FFFFFF;
    color: #6750A4;
    font-weight: 600;
    box-shadow: 0 2rpx 8rpx rgba(28, 27, 31, 0.10);
}

/* 图表卡片 */
.chart-card {
    position: relative;
    box-sizing: border-box;
    padding: 24rpx 20rpx 20rpx;
    border-radius: 24rpx;
    background: #FFFFFF;
    box-shadow: 0 2rpx 8rpx rgba(28, 27, 31, 0.10);
    margin-bottom: 24rpx;
}

/* 切换时间范围的加载动画层（覆盖图表区域） */
.chart-loading {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.90);
    border-radius: 24rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.chart-loading-text {
    margin-top: 16rpx;
    color: #49454F;
    font-size: 24rpx;
}

.chart-canvas {
    width: 100%;
    height: 560rpx;
}

.legend {
    display: flex;
    flex-wrap: wrap;
    margin-top: 8rpx;
    padding: 0 8rpx;
}

.legend-item {
    display: flex;
    align-items: center;
    margin-right: 24rpx;
    margin-bottom: 8rpx;
}

.legend-dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    margin-right: 8rpx;
}

.legend-line {
    width: 22rpx;
    height: 0;
    border-top: 2rpx dashed #B3261E;
    margin-right: 8rpx;
}

.legend-text {
    color: #49454F;
    font-size: 22rpx;
}

/* 统计卡 */
.stats-card {
    box-sizing: border-box;
    padding: 24rpx 20rpx;
    border-radius: 24rpx;
    background: #FFFFFF;
    box-shadow: 0 2rpx 8rpx rgba(28, 27, 31, 0.10);
    margin-bottom: 24rpx;
}

.stat-grid {
    display: flex;
    flex-wrap: wrap;
}

.stat-cell {
    width: 33.33%;
    box-sizing: border-box;
    padding: 14rpx 8rpx;
    text-align: center;
}

.stat-value {
    display: block;
    font-size: 38rpx;
    font-weight: 700;
    color: #1C1B1F;
}

.stat-label {
    display: block;
    margin-top: 6rpx;
    color: #49454F;
    font-size: 22rpx;
}

.stat-time {
    display: block;
    margin-top: 16rpx;
    color: #49454F;
    font-size: 22rpx;
    text-align: center;
}

/* 用药时间线 */
.content-card {
    box-sizing: border-box;
    padding: 28rpx;
    border-radius: 24rpx;
    background: #FFFFFF;
    box-shadow: 0 2rpx 8rpx rgba(28, 27, 31, 0.10);
    margin-bottom: 0;
}

.timeline-item {
    display: flex;
    align-items: flex-start;
    padding: 20rpx 0 8rpx;
}

.timeline-dot {
    width: 16rpx;
    height: 16rpx;
    margin-top: 10rpx;
    border-radius: 50%;
    background: #6750A4;
    flex-shrink: 0;
}

.timeline-main {
    flex: 1;
    margin-left: 20rpx;
    padding-bottom: 12rpx;
    border-bottom: 2rpx solid #F3EDF7;
}

.timeline-time {
    display: block;
    color: #49454F;
    font-size: 22rpx;
}

.timeline-name {
    display: block;
    margin-top: 6rpx;
    color: #1C1B1F;
    font-size: 28rpx;
    font-weight: 600;
}

.timeline-dose {
    color: #49454F;
    font-size: 24rpx;
    font-weight: 400;
}

.timeline-tag {
    display: inline-block;
    margin-top: 8rpx;
    padding: 2rpx 14rpx;
    border-radius: 999rpx;
    background: #E8DEF8;
    color: #1D192B;
    font-size: 20rpx;
}
