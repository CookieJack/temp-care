/* 用药历史页特有样式（只读 + 按批次分组）；MD 通用样式见 app.wxss */

.group-head {
    padding-bottom: 8rpx;
}

.med-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}

.med-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #1C1B1F;
}

.med-dose {
    margin-left: 16rpx;
    color: #49454F;
    font-size: 26rpx;
}

.med-tag {
    margin-left: 12rpx;
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    background: #E8DEF8;
    color: #1D192B;
    font-size: 22rpx;
}

/* 体温历史同类标签（样式与用药页保持一致） */
.temp-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}
