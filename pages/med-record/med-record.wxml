<view class="page">
    <view class="md-head">
        <text class="md-head-eyebrow">MEDICATION</text>
        <text class="md-head-title">用药历史</text>
        <text class="md-head-sub">按批次分组只读查看 · 编辑或删除请进入所属批次 · 当前档案：{{profileName}}</text>
    </view>

    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="state-title">正在加载</text>
        <text class="state-description">请稍候，记录马上准备好。</text>
    </view>

    <view class="state-card" wx:elif="{{viewState === 'empty'}}">
        <text class="state-icon">○</text>
        <text class="state-title">暂无用药记录</text>
        <text class="state-description">在批次内快速记录后，这里会按批次分组显示。</text>
    </view>

    <view class="state-card state-card-error" wx:elif="{{viewState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">加载失败</text>
        <text class="state-description">{{errorMessage}}</text>
        <view class="primary-button" hover-class="btn-hover" bindtap="handleRetry">重试</view>
    </view>

    <block wx:else>
        <view class="md-card" wx:for="{{groups}}" wx:key="id">
            <view class="section-head group-head" hover-class="hover-cell" wx:if="{{item.id !== ''}}" data-id="{{item.id}}" bindtap="openBatchDetail">
                <view class="section-lead"><text class="section-emoji">💊</text><text class="section-title">{{item.name}}</text></view>
                <text class="section-link">{{item.items.length}} 条 · 查看 ›</text>
            </view>
            <view class="section-head group-head" wx:else>
                <view class="section-lead"><text class="section-emoji">🗂️</text><text class="section-title">{{item.name}}</text></view>
                <text class="section-hint">{{item.items.length}} 条</text>
            </view>
            <view class="list-item" wx:for="{{item.items}}" wx:for-item="rec" wx:key="id">
                <view class="list-main">
                    <view class="med-line">
                        <text class="med-name">{{rec.name}}</text>
                        <text class="med-dose">{{rec.doseText}}</text>
                        <text class="tl-method" wx:if="{{rec.manufacturer !== ''}}">{{rec.manufacturer}}</text>
                        <text class="med-tag" wx:if="{{rec.sourceLabel !== ''}}">{{rec.sourceLabel}}</text>
                    </view>
                    <text class="item-time">{{rec.timeText}}</text>
                    <text class="item-note" wx:if="{{rec.noteText !== ''}}">{{rec.noteText}}</text>
                </view>
            </view>
        </view>
    </block>
</view>
